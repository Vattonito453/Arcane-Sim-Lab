# Build context hygiene for the api and worker images (context = repo root).
# Without this, every image build uploads ~600 MB of node_modules, sim results
# and git history to the docker daemon before COPY even runs.

.git
.gitignore
.dockerignore

# Front end builds from its own context (web/) with its own dockerignore.
web

# Generated runtime state — lives on the /data volume, never in an image.
engine/sim_results
engine/jobs.db*
engine/card_cache.json
engine/combo_cache.json
engine/__pycache__
**/__pycache__

# WotC Comprehensive Rules source text: the KB under rules/kb is what ships.
rules/raw

# Local-only material.
mockups
training
frontend_handoff
tasks
*.zip
*.command
*.md
!deploy/*.md
.DS_Store
**/.DS_Store
# AppleDouble sidecars. macOS tar writes "._name" for any file with extended
# attributes; on Linux they extract as real files and match globs like
# engine/decks/*.dck. Keeping them out of the build context is the last line of
# defence behind COPYFILE_DISABLE=1 at archive time.
._*
**/._*
MtG Rules Engine
