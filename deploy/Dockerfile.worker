# MTG Engine — simulation worker (Java 17 + Forge + the Python worker loop)
# Build from the repo root:  docker build -f deploy/Dockerfile.worker -t mtg-worker .
FROM eclipse-temurin:17-jre-jammy

# xvfb and the X11/font libraries are NOT optional, despite this being a
# headless simulation. Forge ships one desktop jar for both GUI and `sim` mode,
# and forge.GuiDesktop's static initializer calls initializeScreenScale() ->
# getDefaultScreenDevice() before sim mode is reached. With no display it throws
# HeadlessException; forcing -Djava.awt.headless=false instead fails on a
# missing libXext.so.6. Both were reproduced in this image — and the failure is
# SILENT, because Forge registers a Sentry handler that swallows the exception
# and exits 1 with no output. A virtual framebuffer satisfies the AWT call.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 curl bzip2 xvfb \
      libxext6 libxrender1 libxtst6 libxi6 fontconfig libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

# Forge (headless-capable desktop build, includes card DB + res/)
ARG FORGE_VERSION=2.0.13
RUN mkdir -p /opt/forge && cd /opt/forge \
    && curl -L -o forge.tar.bz2 \
       "https://github.com/Card-Forge/forge/releases/download/forge-${FORGE_VERSION}/forge-installer-${FORGE_VERSION}.tar.bz2" \
    && tar xjf forge.tar.bz2 && rm forge.tar.bz2

WORKDIR /app
COPY rules/kb/ /app/rules/kb/
COPY engine/*.py /app/engine/
COPY engine/decks/*.dck /app/engine/decks/

# simlab-forge-shim (optional): run deploy/sync-shim.sh before building to
# stage the jar; without it the directory carries only its README and the
# worker supports only --agent forge. SIMLAB_SHIM_JAR is where run_sim.py
# looks; a missing file just disables the shim agent.
COPY deploy/vendor/ /opt/simlab-forge-shim/
ENV SIMLAB_SHIM_JAR=/opt/simlab-forge-shim/simlab-forge-shim.jar

# Forge writes its profile under $HOME; run_sim stages decks via FORGE_USER_DIR
ENV HOME=/root \
    FORGE_USER_DIR=/root/.forge \
    MTG_DATA_DIR=/data
RUN bash -lc 'JAR=$(find /opt/forge -name "forge-gui-desktop-*jar-with-dependencies.jar" | head -1) && \
    echo "export FORGE_JAR=$JAR" >> /etc/profile.d/forge.sh && \
    ln -s "$JAR" /opt/forge/forge.jar'
ENV FORGE_JAR=/opt/forge/forge.jar
VOLUME /data

# The entrypoint starts Xvfb and exports DISPLAY, which every java child
# inherits. It replaces xvfb-run, whose SIGUSR1 readiness handshake does not
# complete as PID 1 — see the comments in worker-entrypoint.sh.
# python3 -u because stdout to a pipe is block-buffered: without it
# `docker compose logs worker` stays empty until 8 KB accumulates, which hid
# this very failure behind a container that looked merely idle.
COPY deploy/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
CMD ["python3", "-u", "engine/worker.py"]
