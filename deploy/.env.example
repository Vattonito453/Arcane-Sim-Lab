# Copy to deploy/.env and edit. Never commit the real .env.

# REQUIRED. Comma-separated API keys allowed to POST /simulate and /decks.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MTG_API_KEYS=replace-me

# Where the API listens on the host. Keep it on loopback and put a TLS-terminating
# reverse proxy (Caddy/nginx/Cloudflare Tunnel) in front. Use 0.0.0.0:8484 only if
# something else is already handling TLS and access control.
MTG_PORT=127.0.0.1:8484

# CORS origin for the browser app. Set this to your real front-end origin in
# production; "*" is convenient in dev and too permissive in public.
MTG_ALLOW_ORIGIN=https://simlab.example.com

# Abuse limits. A simulation is the expensive resource: a 4 GB JVM for 10-60 min.
MTG_SIM_PER_HOUR=6        # per API key (falls back to per IP when unauthenticated)
MTG_SIM_MAX_GAMES=64      # rejects a single enormous job
MTG_SIM_MAX_QUEUED=3      # queue depth backpressure across all callers
MTG_READ_PER_MIN=240      # per caller, read endpoints

# Worker sizing. Forge runs with -Xmx4g, so keep memory above that.
MTG_WORKER_MEM=5g
MTG_WORKER_CPUS=2
