# MTG Engine — API container (rules KB + HTTP API + dashboard; no Java needed)
# Build from the repo root:  docker build -f deploy/Dockerfile.api -t mtg-api .
FROM python:3.12-slim

WORKDIR /app
COPY rules/kb/ /app/rules/kb/
COPY engine/*.py /app/engine/
# The glob above is top level only, so engine/models/ never shipped: the
# fitted prediction model lives in a subdirectory, and /results/{file}/prediction
# answered "no fitted model" in production while working fine locally.
COPY engine/models/ /app/engine/models/
COPY engine/decks/*.dck /app/engine/decks/
# The deployment self-check, shipped so it can be run against a live container
# with one command and no file copying. It is the only check that catches a
# feature which is built, merged, deployed, and answering 200 while dark.
COPY deploy/preflight.py /app/deploy/preflight.py

ENV MTG_DATA_DIR=/data \
    MTG_EMBEDDED_WORKER=0
VOLUME /data
EXPOSE 8484

# -u for the same reason as the worker: unbuffered container logs.
CMD ["python3", "-u", "engine/mtg_engine.py", "serve", "8484"]
