# Copy to deploy/.env and edit. Never commit the real .env.

# REQUIRED. Comma-separated API keys allowed to POST /simulate and /decks.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MTG_API_KEYS=replace-me

# REQUIRED for the web container. ONE key from MTG_API_KEYS, baked into the
# front-end bundle at build time so playtesters can start runs without pasting
# anything. Anyone who can load the page can read it — acceptable for a trusted
# group; rebuild the web image to rotate it.
WEB_API_KEY=replace-me

# Where the front end listens on the host. 80 for a plain-HTTP playtest box;
# put Caddy or nginx in front and move this off 80 when you add TLS.
WEB_PORT=80

# Where the API listens on the host. Loopback: the web container reaches it over
# the compose network (ENGINE_ORIGIN), so the engine never needs public exposure.
MTG_PORT=127.0.0.1:8484

# CORS origin for the browser app. Set this to your real front-end origin in
# production; "*" is convenient in dev and too permissive in public.
MTG_ALLOW_ORIGIN=https://simlab.example.com

# Abuse limits. A simulation is the expensive resource: a 4 GB JVM for 10-60 min.
MTG_SIM_PER_HOUR=6        # per API key (falls back to per IP when unauthenticated)
MTG_SIM_MAX_GAMES=64      # rejects a single enormous job
MTG_SIM_MAX_QUEUED=3      # queue depth backpressure across all callers
MTG_READ_PER_MIN=240      # per caller, read endpoints
MTG_ASK_PER_HOUR=30       # per caller, POST /ask — the paid-token rules assistant

# OPTIONAL. Rules-assistant generation (POST /ask). Absent = the endpoint
# degrades to plain rules search; answers are cached forever once generated.
# MTG_LLM_API_KEY=
# MTG_LLM_MODEL=claude-haiku-4-5

# Worker sizing. Forge runs with -Xmx4g, so keep memory above that.
MTG_WORKER_MEM=5g
MTG_WORKER_CPUS=2
