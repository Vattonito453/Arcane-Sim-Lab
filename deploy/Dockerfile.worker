# MTG Engine — simulation worker (Java 17 + Forge + the Python worker loop)
# Build from the repo root:  docker build -f deploy/Dockerfile.worker -t mtg-worker .

# ---- Forge download (shared by the shim builder and the runtime) ----
FROM eclipse-temurin:17-jre-jammy AS forge
ARG FORGE_VERSION=2.0.13
RUN apt-get update && apt-get install -y --no-install-recommends curl bzip2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /opt/forge && cd /opt/forge \
    && curl -L -o forge.tar.bz2 \
       "https://github.com/Card-Forge/forge/releases/download/forge-${FORGE_VERSION}/forge-installer-${FORGE_VERSION}.tar.bz2" \
    && tar xjf forge.tar.bz2 && rm forge.tar.bz2

# ---- simlab-forge-shim (GPL, separate repo — see CLAUDE.md legal posture) ----
# Humanized simulation is the product default, so the worker image must carry
# the shim. Source of the jar, in order:
#   1. deploy/vendor/simlab-forge-shim.jar if staged (deploy/sync-shim.sh —
#      the local-dev path; the file is gitignored)
#   2. otherwise clone SIMLAB_SHIM_REPO and build from source (the VM path;
#      requires the shim repo to be public/reachable)
FROM eclipse-temurin:17-jdk-jammy AS shim-builder
ARG SIMLAB_SHIM_REPO=https://github.com/Vattonito453/simlab-forge-shim.git
ARG SIMLAB_SHIM_REF=main
COPY --from=forge /opt/forge /opt/forge
COPY deploy/vendor/ /vendor/
# CACHE BUSTER — do not remove. The clone below is a fixed command string, so
# Docker happily reuses its cached layer forever: shim commits pushed after the
# image was first built NEVER reached the worker. Measured 2026-08-02, the VM
# was running a Stage-3 shim while main carried Stage 5, with nothing in the
# build output saying so. ADD of a URL re-fetches and hashes its content, so
# when the shim's ref moves this layer (and the clone after it) invalidates.
ADD https://api.github.com/repos/Vattonito453/simlab-forge-shim/commits/${SIMLAB_SHIM_REF} /shim-ref.json
RUN if [ -f /vendor/simlab-forge-shim.jar ]; then \
      echo "shim: using staged vendor jar" && cp /vendor/simlab-forge-shim.jar /shim.jar \
      && echo "vendor-staged" > /shim.commit; \
    else \
      echo "shim: building from ${SIMLAB_SHIM_REPO}@${SIMLAB_SHIM_REF}" \
      && apt-get update && apt-get install -y --no-install-recommends git \
      && rm -rf /var/lib/apt/lists/* \
      && git clone --depth 1 -b "${SIMLAB_SHIM_REF}" "${SIMLAB_SHIM_REPO}" /shim-src \
      && cd /shim-src \
      && git rev-parse HEAD > /shim.commit \
      && FORGE_JAR="$(find /opt/forge -name 'forge-gui-desktop-*jar-with-dependencies.jar' | head -1)" \
         ./build.sh \
      && cp simlab-forge-shim.jar /shim.jar; \
    fi

# ---- runtime ----
FROM eclipse-temurin:17-jre-jammy

# xvfb and the X11/font libraries are NOT optional, despite this being a
# headless simulation. Forge ships one desktop jar for both GUI and `sim` mode,
# and forge.GuiDesktop's static initializer calls initializeScreenScale() ->
# getDefaultScreenDevice() before sim mode is reached. With no display it throws
# HeadlessException; forcing -Djava.awt.headless=false instead fails on a
# missing libXext.so.6. Both were reproduced in this image — and the failure is
# SILENT, because Forge registers a Sentry handler that swallows the exception
# and exits 1 with no output. A virtual framebuffer satisfies the AWT call.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 curl bzip2 xvfb \
      libxext6 libxrender1 libxtst6 libxi6 fontconfig libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

# Forge (headless-capable desktop build, includes card DB + res/) — pulled
# verbatim in the shared `forge` stage above.
COPY --from=forge /opt/forge /opt/forge

WORKDIR /app
COPY rules/kb/ /app/rules/kb/
COPY engine/*.py /app/engine/
COPY engine/decks/*.dck /app/engine/decks/

# The shim jar (vendor-staged or built from source in shim-builder).
# run_sim.py's default agent is 'auto' = humanized via this jar.
COPY --from=shim-builder /shim.jar /opt/simlab-forge-shim/simlab-forge-shim.jar
# Provenance: which shim commit this image actually carries. Without it, the
# only way to tell was unzipping the jar and grepping the constant pool — which
# is how the stale-shim bug above went unnoticed. The worker logs it at startup.
COPY --from=shim-builder /shim.commit /opt/simlab-forge-shim/COMMIT
ENV SIMLAB_SHIM_JAR=/opt/simlab-forge-shim/simlab-forge-shim.jar

# Forge writes its profile under $HOME; run_sim stages decks via FORGE_USER_DIR
ENV HOME=/root \
    FORGE_USER_DIR=/root/.forge \
    MTG_DATA_DIR=/data
RUN bash -lc 'JAR=$(find /opt/forge -name "forge-gui-desktop-*jar-with-dependencies.jar" | head -1) && \
    echo "export FORGE_JAR=$JAR" >> /etc/profile.d/forge.sh && \
    ln -s "$JAR" /opt/forge/forge.jar'
ENV FORGE_JAR=/opt/forge/forge.jar
VOLUME /data

# The entrypoint starts Xvfb and exports DISPLAY, which every java child
# inherits. It replaces xvfb-run, whose SIGUSR1 readiness handshake does not
# complete as PID 1 — see the comments in worker-entrypoint.sh.
# python3 -u because stdout to a pipe is block-buffered: without it
# `docker compose logs worker` stays empty until 8 KB accumulates, which hid
# this very failure behind a container that looked merely idle.
COPY deploy/worker-entrypoint.sh /usr/local/bin/worker-entrypoint.sh
RUN chmod +x /usr/local/bin/worker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/worker-entrypoint.sh"]
CMD ["python3", "-u", "engine/worker.py"]
